    local conn
    conn = UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Keyboard then
            Config.ToggleKey = input.KeyCode
            keyBtn.Text = input.KeyCode.Name
            keyBtn.TextColor3 = UI_COLORS.TextPrimary
            conn:Disconnect()
            SaveConfig()
        end
    end)
end)

