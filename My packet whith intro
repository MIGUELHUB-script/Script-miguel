local gui = Instance.new("ScreenGui")
gui.Name = NAME
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 999999
gui.Parent = parent

local alive = true

local function make(class,p,props)
    local o = Instance.new(class)
    for k,v in pairs(props) do o[k]=v end
    o.Parent=p
    return o
end

local function tw(o,t,props,style)
    if not o or not o.Parent then return end
    local x=TweenService:Create(
        o,
        TweenInfo.new(t,style or Enum.EasingStyle.Quint,
        Enum.EasingDirection.Out),
        props
    )
    x:Play()
    return x
end

local function finish()
    if not alive then return end
    alive=false
    for _,o in ipairs(gui:GetDescendants()) do
        if o:IsA("TextLabel") or o:IsA("TextButton") then
            tw(o,0.3,{TextTransparency=1})
        elseif o:IsA("Frame") then
            tw(o,0.3,{BackgroundTransparency=1})
        end
    end
    task.delay(0.4,function()
        if gui.Parent then gui:Destroy() end
    end)
end

